# The single user that Syncy creates and keeps in sync on every startup.
# Changing the password here updates the stored password and revokes old sessions.
SYNCY_EMAIL=you@example.com
SYNCY_PASSWORD=change-this-to-a-long-random-password
SYNCY_NAME=Syncy User

# Leave false for a single-user server. Set true only if you want open sign-ups.
ALLOW_REGISTRATION=false

# Server
HOST=0.0.0.0
PORT=8080
DATA_DIR=./data
PUBLIC_URL=http://localhost:8080

# Optional hardening / tuning
# JWT_SECRET=replace-with-at-least-32-random-characters
# SETUP_TOKEN=only-needed-without-SYNCY_EMAIL
# CORS_ORIGINS=
# MAX_BLOB_BYTES=536870912
# MAX_JSON_BODY_BYTES=2097152
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# RATE_LIMIT_MAX=600
# TRUST_PROXY=false
# LOG_LEVEL=info
